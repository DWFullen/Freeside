<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Warnings are errors, with the latest recommended analyzer set and
         .editorconfig code-style rules enforced at build time. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Reproducible output. ContinuousIntegrationBuild normalizes source
         paths; GitHub Actions sets CI=true. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Every project commits packages.lock.json. CI restores in locked mode
         (see README, "Build and test"). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Vulnerable packages (direct and transitive) fail the build, except
         low-severity advisories (NU1901), which stay warnings. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
