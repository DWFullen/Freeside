<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org. <clear/> drops machine- and user-level feeds, and source
     mapping pins every package ID to this feed (dependency-confusion guard). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
